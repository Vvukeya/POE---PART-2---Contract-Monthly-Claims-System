@model POE___PART_2___Contract_Monthly_Claims_System.Models.Claim
@{
    ViewData["Title"] = "Edit Claim – Lecturer";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/Style.css">
</head>
<body>
    <header>
        <h1>CMCS – Lecturer</h1>
        <a href="@Url.Action("Logout", "Home")" class="signout-btn">Sign Out</a>
    </header>

    <nav>
        <ul>
            <li><a href="@Url.Action("LecturerTrack", "Home")">Back to My Claims</a></li>
            <li><a href="@Url.Action("LecturerDashboard", "Home")">Dashboard</a></li>
        </ul>
    </nav>

    <div class="container">
        <div class="card">
            <h2>Edit & Resubmit Claim #@Model.ClaimID</h2>

            @if (!string.IsNullOrEmpty(Model.CorrectionNotes))
            {
                <div style="background: #fff3cd; color: #856404; padding: 15px; border-radius: 5px; margin-bottom: 20px;">
                    <h4>Reason for Rejection:</h4>
                    <p>@Model.CorrectionNotes</p>
                </div>
            }

            <form method="post" asp-action="LecturerEditClaim" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="claimId" value="@Model.ClaimID" />

                <div class="row">
                    <div>
                        <label asp-for="Month">Period Month</label>
                        <input asp-for="Month" type="number" min="1" max="12" required>
                        <span asp-validation-for="Month" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="Year">Period Year</label>
                        <input asp-for="Year" type="number" min="2024" max="2030" required>
                        <span asp-validation-for="Year" class="text-danger"></span>
                    </div>
                </div>

                <div class="row-3">
                    <div>
                        <label asp-for="ModuleCode">Module Code</label>
                        <input asp-for="ModuleCode" required>
                        <span asp-validation-for="ModuleCode" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="Hours">Hours Worked</label>
                        <input asp-for="Hours" type="number" step="0.1" required>
                        <span asp-validation-for="Hours" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="HourlyRate">Hourly Rate (R)</label>
                        <input asp-for="HourlyRate" type="number" step="0.01" required>
                        <span asp-validation-for="HourlyRate" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="Sessions">Number of Sessions</label>
                        <input asp-for="Sessions" type="number" required>
                        <span asp-validation-for="Sessions" class="text-danger"></span>
                    </div>
                </div>

                <label asp-for="Description">Work Description</label>
                <textarea asp-for="Description" required rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>

                <label for="correctionNotes">Correction Notes</label>
                <textarea id="correctionNotes" name="correctionNotes" rows="3" placeholder="Explain what changes you made to address the rejection..."></textarea>

                <div style="margin-top:20px">
                    <label>Additional Supporting Documents (Optional)</label>
                    <input type="file" name="files" multiple accept=".pdf,.docx,.xlsx">
                    <small>You can upload additional files if needed. Max 5MB each.</small>
                </div>

                <div style="margin-top:20px; display:flex; gap:10px">
                    <a href="@Url.Action("LecturerTrack", "Home")" class="btn btn-ghost">Cancel</a>
                    <button class="btn btn-primary" type="submit">Resubmit Claim</button>
                </div>
            </form>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>