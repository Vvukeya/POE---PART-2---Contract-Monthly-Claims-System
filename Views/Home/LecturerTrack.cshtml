@model List<POE___PART_2___Contract_Monthly_Claims_System.Models.Claim>
@{
    ViewData["Title"] = "Track My Claims – Lecturer Page";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/Style.css">
</head>
<body>
    <header>
        <h1>CMCS – Lecturer</h1>
        <a href="@Url.Action("Logout", "Home")" class="signout-btn">Sign Out</a>
    </header>

    <nav>
        <ul>
            <li><a href="@Url.Action("LecturerSubmitClaim", "Home")">Submit Claim</a></li>
            <li><a href="@Url.Action("LecturerDashboard", "Home")">Dashboard</a></li>
        </ul>
    </nav>

    <div class="container">
        <div class="card">
            <h2>My Claims Status</h2>

            @if (TempData["Success"] != null)
            {
                <div style="background: #d4edda; color: #155724; padding: 10px; border-radius: 5px; margin-bottom: 15px;">
                    @TempData["Success"]
                </div>
            }

            @if (!Model.Any())
            {
                <p>No claims found. <a href="@Url.Action("LecturerSubmitClaim", "Home")">Submit your first claim!</a></p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Claim ID</th>
                            <th>Period</th>
                            <th>Total Amount</th>
                            <th>Hours</th>
                            <th>Hour Rate</th>
                            <th>Date of Submission</th>
                            <th>Sessions</th>
                            <th>Status</th>
                            <th>Documents</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var claim in Model)
                        {
                            <tr>
                                <td>#@claim.ClaimID</td>
                                <td>@claim.Month/@claim.Year</td>
                                <td>R @claim.TotalAmount.ToString("N2")</td>
                                <td>@claim.Hours</td>
                                <td>R @claim.HourlyRate.ToString("N2")</td>
                                <td>@claim.SubmissionDate.ToString("dd MMM yyyy HH:mm")</td>
                                <td>@claim.Sessions</td>
                                <td>
                                    @if (claim.Status == "Pending")
                                    {
                                        <span class="badge badge-warn">@claim.Status</span>
                                    }
                                    else if (claim.Status == "Verified")
                                    {
                                        <span class="badge badge-info">@claim.Status</span>
                                    }
                                    else if (claim.Status == "Approved")
                                    {
                                        <span class="badge badge-primary">@claim.Status</span>
                                    }
                                    else if (claim.Status == "Paid")
                                    {
                                        <span class="badge badge-success">💰 Paid</span>
                                        <br>
                                        <small>Paid on: @claim.PaymentDate?.ToString("dd-MMM-yyyy")</small>
                                    }
                                    else if (claim.Status == "Rejected")
                                    {
                                        <span class="badge badge-danger">@claim.Status</span>
                                    }
                                    else if (claim.Status == "Resubmitted")
                                    {
                                        <span class="badge badge-resubmitted">@claim.Status</span>
                                    }
                                </td>
                                <td>
                                    @if (claim.Documents != null && claim.Documents.Any())
                                    {
                                        <div style="display: flex; flex-direction: column; gap: 5px;">
                                            @foreach (var document in claim.Documents)
                                            {
                                                <div style="display: flex; gap: 5px; align-items: center;">
                                                    <a href="@Url.Action("ViewDocument", "Home", new { documentId = document.DocumentID })"
                                                       class="btn btn-ghost btn-sm"
                                                       target="_blank"
                                                       style="flex: 1; text-align: left; font-size: 0.8rem;">
                                                        📎 View @document.FileName
                                                    </a>
                                                    <a href="@Url.Action("DownloadDocument", "Home", new { documentId = document.DocumentID })"
                                                       class="btn btn-primary btn-sm"
                                                       style="white-space: nowrap;">
                                                        ⬇️
                                                    </a>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>
                                    @if (claim.Status == "Rejected")
                                    {
                                        <a href="@Url.Action("LecturerEditClaim", "Home", new { id = claim.ClaimID })" class="btn btn-ghost">Edit & Resubmit</a>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</body>
</html>