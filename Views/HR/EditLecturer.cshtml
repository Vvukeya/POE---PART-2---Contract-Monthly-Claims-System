@model POE___PART_2___Contract_Monthly_Claims_System.Models.User
@{
    ViewData["Title"] = "Edit Lecturer – HR";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/Style.css">
</head>
<body>
    <header>
        <h1>CMCS – HR Management</h1>
        <a href="@Url.Action("Logout", "Home")" class="signout-btn">Sign Out</a>
    </header>

    <nav>
        <ul>
            <li><a href="@Url.Action("HRDashboard", "HR")">Dashboard</a></li>
            <li><a href="@Url.Action("ManageLecturers", "HR")">Manage Lecturers</a></li>
        </ul>
    </nav>

    <div class="container">
        <div class="card">
            <h2>Edit Lecturer: @Model.FirstName @Model.Surname</h2>
            <p class="text-muted">Update lecturer information and contact details</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-error">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form method="post" asp-action="EditLecturer" id="editForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserID" />
                <input type="hidden" asp-for="Role" />
                <input type="hidden" asp-for="Password" />
                <input type="hidden" asp-for="RegistrationDate" />
                <input type="hidden" name="currentEmail" value="@Model.Email" />

                <div class="row">
                    <div class="form-group">
                        <label asp-for="FirstName">First Name *</label>
                        <input asp-for="FirstName" required>
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Surname">Surname *</label>
                        <input asp-for="Surname" required>
                        <span asp-validation-for="Surname" class="text-danger"></span>
                    </div>
                </div>

                <!-- Email Update Section with Warning -->
                <div class="form-group">
                    <label asp-for="Email">Email Address *</label>
                    <input asp-for="Email" type="email" required
                           onchange="showEmailWarning(this, '@Model.Email')">
                    <span asp-validation-for="Email" class="text-danger"></span>
                    <small class="text-muted" id="emailWarning" style="display: none; color: #d32f2f; font-weight: bold;">
                        ⚠️ Changing the email will update the login username. The old email will no longer work for login.
                    </small>
                </div>

                <div class="form-group">
                    <label asp-for="PhoneNumber">Phone Number *</label>
                    <input asp-for="PhoneNumber" required>
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Address">Address *</label>
                    <textarea asp-for="Address" rows="3" required></textarea>
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <!-- Lecturer Information Summary -->
                <div class="card" style="background: #f8f9fa; margin: 20px 0;">
                    <h3>📋 Lecturer Information</h3>
                    <div class="row">
                        <div>
                            <strong>Lecturer ID:</strong> @Model.UserID
                        </div>
                        <div>
                            <strong>Role:</strong> @Model.Role
                        </div>
                        <div>
                            <strong>Current Login Email:</strong> <span id="currentEmailDisplay">@Model.Email</span>
                        </div>
                        <div>
                            <strong>Registered:</strong> @Model.RegistrationDate.ToString("dd MMMM yyyy")
                        </div>
                    </div>
                </div>

                <div style="display: flex; gap: 10px; margin-top: 20px;">
                    <a href="@Url.Action("ManageLecturers", "HR")" class="btn btn-ghost">Cancel</a>
                    <button type="submit" class="btn btn-primary" id="submitBtn">Update Lecturer</button>
                </div>
            </form>
        </div>

        <!-- Email Change Information Card -->
        <div class="card" style="background: #fff3cd; border-left: 4px solid #ff9800;">
            <h3>📧 Email Change Information</h3>
            <p><strong>When you change a lecturer's email address:</strong></p>
            <ul style="list-style-type: disc; margin-left: 20px;">
                <li>The new email becomes the login username immediately</li>
                <li>The old email will no longer work for login</li>
                <li>All dashboards will reflect the new email</li>
                <li>The lecturer will need to use the new email for future logins</li>
                <li>All existing claims and records are preserved</li>
            </ul>
        </div>
    </div>

    <script>
        function showEmailWarning(input, originalEmail) {
            const warningElement = document.getElementById('emailWarning');
            const currentEmailDisplay = document.getElementById('currentEmailDisplay');

            if (input.value !== originalEmail) {
                warningElement.style.display = 'block';
                currentEmailDisplay.style.color = '#d32f2f';
                currentEmailDisplay.style.fontWeight = 'bold';
                currentEmailDisplay.textContent = originalEmail + ' → ' + input.value;
            } else {
                warningElement.style.display = 'none';
                currentEmailDisplay.style.color = '';
                currentEmailDisplay.style.fontWeight = '';
                currentEmailDisplay.textContent = originalEmail;
            }
        }

        // Simple reset confirmation
        function confirmReset() {
            if (confirm('Reset all changes?')) {
                document.getElementById('editForm').reset();
                document.getElementById('emailWarning').style.display = 'none';
                const currentEmailDisplay = document.getElementById('currentEmailDisplay');
                currentEmailDisplay.style.color = '';
                currentEmailDisplay.style.fontWeight = '';
                currentEmailDisplay.textContent = '@Model.Email';
            }
            return false;
        }

        // Form submission confirmation for email changes
        document.getElementById('editForm').addEventListener('submit', function(e) {
            const emailInput = document.querySelector('input[name="Email"]');
            const currentEmail = document.querySelector('input[name="currentEmail"]').value;

            if (emailInput.value !== currentEmail) {
                if (!confirm(`You are changing the login email from "${currentEmail}" to "${emailInput.value}". The lecturer will need to use the new email for login. Continue?`)) {
                    e.preventDefault();
                }
            }
        });
    </script>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>